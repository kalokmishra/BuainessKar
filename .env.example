# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration Template (Copy to .env.local and fill in real values)
# For Vite React applications, use VITE_ prefix for client-side access:
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_PROJECT_ID=global-fort-mfht8
VITE_FIREBASE_AUTH_DOMAIN=global-fort-mfht8.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=global-fort-mfht8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=952143367787
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_ID=1:952143367787:web:cf5f5c092894c77742eb2e
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-taxutilitymvpsec-73c0f477-424e-4989-b3d1-90275716ca08
VITE_FIREBASE_OAUTH_CLIENT_ID=952143367787-uggu4ov2e3rtjsd84t4k0iacj74r011n.apps.googleusercontent.com
VITE_DEFAULT_USER_EMAIL=user@example.com
VITE_DEFAULT_DEMO_EMAIL=rahul@taxpro.in
VITE_DEFAULT_DEMO_NAME="Rahul (IT Consultant)"
VITE_SECONDARY_DEMO_PHONE="9876543210"
VITE_SECONDARY_DEMO_NAME="Priya (Retail Trader)"
VITE_ADMIN_SUPPORT_EMAIL=contactadmin@businesskar.com
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Also supports CRA/Next style REACT_APP_ aliases:
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_PROJECT_ID=global-fort-mfht8
REACT_APP_FIREBASE_AUTH_DOMAIN=global-fort-mfht8.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=global-fort-mfht8.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=952143367787
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_APP_ID=1:952143367787:web:cf5f5c092894c77742eb2e
REACT_APP_FIREBASE_OAUTH_CLIENT_ID=952143367787-uggu4ov2e3rtjsd84t4k0iacj74r011n.apps.googleusercontent.com
